# ==============================================================================
# Vighna / KB4Trade Trading Bot Configuration
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# --- Telegram User & Channel Settings ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=telegram_session
TELEGRAM_CHANNEL_ID=
COMMODITY_CHANNEL_ID=

# --- Telegram Bot Alerts ---
# Bot token created via @BotFather to send broadcast trade notifications
TELEGRAM_BOT_TOKEN=

# --- Angel One SmartAPI Credentials ---
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# --- Trading Engine & Risk Management ---
# Environment: 'paper' for simulated trading, 'real' for live order execution
APP_ENV=paper
PAPER_ONLY=true
BROKER=ANGELONE

# Starting capital per segment (INR)
INITIAL_CAPITAL=100000

# Entry timeout: how long to wait for price to enter the trigger range (seconds)
ENTRY_WAIT_SECONDS=300

# End-of-day square-off time (IST, format HH:MM)
EOD_CLOSE_TIME=15:15
TIMEZONE=Asia/Kolkata

# Market data staleness threshold in milliseconds
MAX_TICK_AGE_MS=2000